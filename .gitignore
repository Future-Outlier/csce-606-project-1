# ==============================================================================
# Dependencies and Bundler
# ==============================================================================
# Ignore the local bundler configuration
/.bundle/

# Ignore gems fetched directly into vendor/bundle
/vendor/bundle/

# Ignore compiled gem binaries or packaging directories
*.gem
/pkg/

# ==============================================================================
# Environment Variables and Secrets (CRITICAL)
# ==============================================================================
# Ignore local environment variables and secrets files
.env
.env*.local

# Ignore Rails master key used for decrypting credentials
/config/master.key
/config/credentials/*.key

# ==============================================================================
# Logs, Temp Files, and Caches
# ==============================================================================
# Ignore all runtime log files and temporary folders
/log/*
/tmp/*

# If you want to keep the log/tmp directories but ignore contents, un-comment:
# !/log/.keep
# !/tmp/.keep

# Ignore pidfiles (process IDs) while leaving the folder structure
/tmp/pids/*

# Ignore the history file generated by the Byebug debugger
.byebug_history

# ==============================================================================
# Databases and Storage (mainly for Rails/ActiveRecord)
# ==============================================================================
# Ignore local SQLite databases and their temporary journals
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-[0-9]*

# Ignore locally uploaded files/attachments (Active Storage)
/storage/*
!/storage/.keep
/tmp/storage/*

# ==============================================================================
# Testing and Coverage
# ==============================================================================
# Ignore SimpleCov coverage reports
/coverage/

# Ignore specific test framework artifacts
/spec/tmp/
/spec/reports/
/spec/examples.txt
/test/tmp/

# ==============================================================================
# Documentation and Compiled Code
# ==============================================================================
# Ignore generated documentation
/doc/
/_yardoc/
/yardoc/

# Ignore Rubinius compiled cache files
*.rbc

